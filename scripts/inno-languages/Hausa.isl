; *** Inno Setup version 6.5.0+ Hausa messages ***
;
; Translation of Default.isl for Inno Setup 6.7.3, made for CrossTerm.
;
; To download user-contributed translations of this file, go to:
;   https://jrsoftware.org/files/istrans/
;
; Note: When translating this text, do not add periods (.) to the end of
; messages that didn't have them already, because on those messages Inno
; Setup adds the periods automatically (appending a period would result in
; two periods being displayed).

[LangOptions]
; The following three entries are very important. Be sure to read and
; understand the '[LangOptions] section' topic in the help file.
LanguageName=Hausa
LanguageID=$0468
; LanguageCodePage should always be set if possible, even if this file is Unicode
; Set to zero: this file is Unicode and Hausa letters are not in one ANSI code page
LanguageCodePage=0
; If the language you are translating to requires special font faces or
; sizes, uncomment any of the following entries and change them accordingly.
;DialogFontName=
;DialogFontSize=9
;DialogFontBaseScaleWidth=7
;DialogFontBaseScaleHeight=15
;WelcomeFontName=Segoe UI
;WelcomeFontSize=14

[Messages]

; *** Application titles
SetupAppTitle=Shigarwa
SetupWindowTitle=Shigarwa - %1
UninstallAppTitle=Cirewa
UninstallAppFullTitle=Cire %1

; *** Misc. common
InformationTitle=Bayani
ConfirmTitle=Tabbatarwa
ErrorTitle=Kuskure

; *** SetupLdr messages
SetupLdrStartupMessage=Wannan zai shigar da %1. Kana son ci gaba?
LdrCannotCreateTemp=Ba a iya ƙirƙirar fayil na wucin gadi ba. An dakatar da shigarwa
LdrCannotExecTemp=Ba a iya gudanar da fayil a babban fayil na wucin gadi ba. An dakatar da shigarwa
HelpTextNote=

; *** Startup error messages
LastErrorMessage=%1.%n%nKuskure %2: %3
SetupFileMissing=Fayil ɗin %1 ya ɓace daga babban fayil na shigarwa. Da fatan za a gyara matsalar ko a samo sabon kwafin shirin.
SetupFileCorrupt=Fayilolin shigarwa sun lalace. Da fatan za a samo sabon kwafin shirin.
SetupFileCorruptOrWrongVer=Fayilolin shigarwa sun lalace, ko ba su dace da wannan sigar Shigarwa ba. Da fatan za a gyara matsalar ko a samo sabon kwafin shirin.
InvalidParameter=An aika siga mara inganci a layin umarni:%n%n%1
SetupAlreadyRunning=Shigarwa tana gudana tuni.
WindowsVersionNotSupported=Wannan shirin bai dace da sigar Windows da ke kan kwamfutarka ba.
WindowsServicePackRequired=Wannan shirin yana buƙatar %1 Service Pack %2 ko sabo.
NotOnThisPlatform=Wannan shirin ba zai yi aiki a kan %1 ba.
OnlyOnThisPlatform=Dole ne a gudanar da wannan shirin a kan %1.
OnlyOnTheseArchitectures=Ana iya shigar da wannan shirin ne kawai a kan sigogin Windows da aka tsara don waɗannan nau'ikan na'urar sarrafawa:%n%n%1
WinVersionTooLowError=Wannan shirin yana buƙatar %1 sigar %2 ko sabo.
WinVersionTooHighError=Ba za a iya shigar da wannan shirin a kan %1 sigar %2 ko sabo ba.
AdminPrivilegesRequired=Dole ne ka shiga a matsayin mai gudanarwa (administrator) kafin ka shigar da wannan shirin.
PowerUserPrivilegesRequired=Dole ne ka shiga a matsayin mai gudanarwa ko memba na rukunin Power Users kafin ka shigar da wannan shirin.
SetupAppRunningError=Shigarwa ta gano cewa %1 yana gudana a yanzu.%n%nDa fatan za a rufe shi gaba ɗaya yanzu, sannan ka danna OK don ci gaba, ko Soke don fita.
UninstallAppRunningError=Cirewa ta gano cewa %1 yana gudana a yanzu.%n%nDa fatan za a rufe shi gaba ɗaya yanzu, sannan ka danna OK don ci gaba, ko Soke don fita.

